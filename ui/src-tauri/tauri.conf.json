{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Create Companion",
  "version": "0.4.0",
  "identifier": "dev.createcompanion.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Create Companion",
        "width": 1440,
        "height": 780,
        "minWidth": 1040,
        "minHeight": 520,
        "center": true,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/create-companion"
    ],
    "shortDescription": "Create Companion",
    "longDescription": "Turns Naya Create Tune and Touch gestures into per-application shortcuts. Installs the background engine and this configuration window.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./nsis/hooks.nsh",
        "startMenuFolder": "Create Companion"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwM0ZFODg3RkQ0M0U5QzcKUldUSDZVUDloK2cvc013MnYvanFBcDhLN0tza0FtYzhtMUx1dGZYY0tQWk00N1F6WFUzU2xIdSsK",
      "endpoints": [
        "https://github.com/create-collective/create-companion/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
